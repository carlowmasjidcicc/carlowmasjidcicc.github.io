---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section class="map-panel" aria-labelledby="map-title" data-google-map>
  <h2 class="visually-hidden" id="map-title">Carlow Masjid on Google Maps</h2>
  <iframe
    class="map-frame"
    title="Google Map showing Carlow Islamic Cultural Centre"
    src={site.mapEmbedUrl}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
    data-map-frame></iframe>
  <a
    class="map-directions button button--gold"
    href={site.directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    Open directions <Icon name="external" size={17} />
  </a>
</section>

<style>
  .map-panel {
    position: relative;
    overflow: hidden;
    min-height: 32rem;
    background: var(--color-ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .map-frame {
    display: block;
    width: 100%;
    height: 32rem;
    border: 0;
  }

  .map-directions {
    position: absolute;
    z-index: 1;
    top: 1rem;
    right: 1rem;
  }
</style>
