---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand", { compact }]}>
  <svg
    class="brand-mark"
    viewBox="0 0 56 56"
    aria-hidden="true"
  >
    <path
      class="arch"
      d="M8 49V29C8 17.4 17 8 28 8s20 9.4 20 21v20H8Z"
    ></path>
    <path class="door" d="M18 49V31c0-6.2 4.5-11 10-11s10 4.8 10 11v18"></path>
    <path
      class="crescent"
      d="M34.8 10.4a9.4 9.4 0 1 1-11.2-7.7 8 8 0 1 0 11.2 7.7Z"
    ></path>
    <path class="base" d="M4 49h48"></path>
  </svg>
  <span class="brand-copy">
    <strong>Carlow Masjid</strong>
    <span>Cultural Centre</span>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
  }

  .brand-mark {
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    overflow: visible;
  }

  .arch {
    fill: rgba(23, 125, 103, 0.12);
    stroke: currentColor;
    stroke-width: 2;
  }

  .door,
  .base {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .crescent {
    fill: var(--color-gold);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .brand-copy span {
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin-top: 0.28rem;
    text-transform: uppercase;
  }

  .compact .brand-copy span {
    display: none;
  }

  @media (max-width: 25rem) {
    .brand-copy span {
      display: none;
    }
  }
</style>
