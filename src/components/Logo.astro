---
import { Image } from "astro:assets";
import officialLogo from "../assets/images/cicc-logo.png";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand", { compact }]}>
  <Image
    class="brand-mark"
    src={officialLogo}
    alt=""
    width={128}
    quality={90}
    loading="eager"
    decoding="async"
  />
  <span class="brand-copy">
    <strong>Carlow Masjid</strong>
    <span>Carlow Islamic Cultural Centre</span>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
  }

  .brand-mark {
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .brand-copy span {
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin-top: 0.28rem;
    text-transform: uppercase;
  }

  .compact .brand-copy span {
    display: none;
  }

  @media (max-width: 25rem) {
    .brand-copy span {
      display: none;
    }
  }
</style>
