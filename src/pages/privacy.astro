---
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy"
  description="Privacy information for the Carlow Islamic Cultural Centre website."
>
  <header class="page-hero">
    <div class="container page-hero__content">
      <p class="eyebrow">Privacy</p>
      <h1>Your privacy choices, clearly explained.</h1>
      <p class="lede">
        The essential website works without analytics. Google Analytics stays
        off until you choose to enable it. The contact page embeds Google Maps
        for the centre location.
      </p>
    </div>
  </header>

  <article class="section">
    <div class="container--narrow policy">
      <section>
        <h2>What this website collects</h2>
        <p>
          The site does not create user accounts or use advertising trackers.
          GitHub Pages, which hosts the site, may process technical request
          information needed to serve pages and protect its service.
        </p>
        <p>
          Your analytics choice is saved in your browser's local storage so
          the website can remember it. This preference is not sent to CICC.
        </p>
      </section>

      <section>
        <h2>Optional Google Analytics</h2>
        <p>
          Google Analytics stays off unless you select “Allow analytics”. If
          allowed, Google receives usage information such as the page visited,
          browser and device details, and approximate location. We use this to
          understand how the website is used and improve it; we do not use it
          for advertising.
        </p>
        <p>
          Google Analytics may set first-party cookies whose names begin with
          <code>_ga</code>. You can change your choice at any time. Choosing
          “Decline” stops Analytics from loading and removes accessible
          Analytics cookies from this site.
        </p>
        <button class="button button--outline" type="button" data-consent-settings>
          Review cookie settings
        </button>
      </section>

      <section>
        <h2>Contact form</h2>
        <p>
          If you submit the contact form, your name, email address, selected
          topic and message are sent to Formspree so the enquiry can be
          delivered to CICC. Formspree receives this information only after you
          choose to submit the form.
        </p>
        <p>
          Do not include sensitive personal, health or financial information.
          You can contact CICC directly at
          <a href={`mailto:${site.email}`}>{site.email}</a> instead.
        </p>
      </section>

      <section>
        <h2>Google Maps and external services</h2>
        <p>
          The contact page embeds Google Maps, centred on Carlow Masjid.
          Loading that page lets Google receive your IP address, browser
          details and map interactions, and Google may set cookies according
          to its own privacy terms.
        </p>
        <p>
          Directions, Facebook, WhatsApp, GoFundMe and SumUp open only after
          you choose their links. Their own privacy terms apply once you leave
          this website. No fundraising, payment or social-media script is
          embedded in the page.
        </p>
      </section>

      <section>
        <h2>Questions or requests</h2>
        <p>
          For a question about information you have sent to CICC, email
          <a href={`mailto:${site.email}`}>{site.email}</a> or call
          <a href={site.phoneHref}>{site.phoneDisplay}</a>.
        </p>
      </section>

      <p class="policy-date">Last reviewed: 29 October 2026</p>
    </div>
  </article>
</BaseLayout>

<style>
  .policy {
    display: grid;
    gap: 2.5rem;
  }

  .policy section {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .policy h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .policy p {
    color: var(--color-text-muted);
  }

  .policy code {
    color: var(--color-heading);
  }

  .policy-date {
    font-size: 0.82rem;
  }
</style>
