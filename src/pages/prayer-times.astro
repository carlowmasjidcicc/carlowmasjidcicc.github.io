---
import Icon from "../components/Icon.astro";
import PrayerPanel from "../components/PrayerPanel.astro";
import PrayerTimetable from "../components/PrayerTimetable.astro";
import { prayerTimetableMeta, timetableMonths } from "../data/prayer-times";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Prayer times"
  description="Verified daily, weekly and monthly prayer start times for Carlow from October 2026 through December 2027."
>
  <header class="page-hero">
    <div class="container page-hero__content">
      <p class="eyebrow">Prayer at Carlow Masjid</p>
      <h1>Clear prayer times, exactly as supplied.</h1>
      <p class="lede">
        Browse verified Carlow prayer starts by day, week or month. Today’s
        current and next prayer are highlighted automatically using local Irish
        time.
      </p>
      <div class="button-row">
        <a class="button" href="#timetable">
          <Icon name="calendar" size={18} />
          Browse timetable
        </a>
        <a
          class="button button--outline"
          href={timetableMonths[0].pdf}
          download
        >
          <Icon name="download" size={18} />
          Download October PDF
        </a>
      </div>
    </div>
  </header>

  <section class="section section--compact">
    <div class="container">
      <PrayerPanel />
    </div>
  </section>

  <section class="section section--soft" id="timetable">
    <div class="container">
      <PrayerTimetable />
    </div>
  </section>

  <section class="section" aria-labelledby="guidance-title">
    <div class="container guidance-layout">
      <div class="content-stack">
        <p class="eyebrow">Read before travelling</p>
        <h2 id="guidance-title">Starts and congregation times are different.</h2>
        <p class="lede">
          The 15 supplied timetables contain Fajr, sunrise, Dhuhr, Asr,
          Maghrib and Isha start times. They do not contain jama’ah or Jumu’ah
          times, so the website does not invent or imply them.
        </p>
        <div class="button-row">
          <a class="button" href={site.phoneHref}>
            <Icon name="phone" size={18} />
            Call {site.phoneDisplay}
          </a>
          <a
            class="button button--outline"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="message" size={18} />
            Ask about jama’ah
          </a>
        </div>
      </div>

      <dl class="timetable-facts">
        <div>
          <dt>Published coverage</dt>
          <dd>1 October 2026–31 December 2027</dd>
        </div>
        <div>
          <dt>Timezone</dt>
          <dd>{prayerTimetableMeta.timezone} · Irish local time</dd>
        </div>
        <div>
          <dt>Prepared by</dt>
          <dd>{prayerTimetableMeta.source}</dd>
        </div>
        <div>
          <dt>Not included</dt>
          <dd>Jama’ah and Jumu’ah times</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .guidance-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    align-items: start;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .guidance-layout h2 {
    max-width: 15ch;
  }

  .timetable-facts {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .timetable-facts div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.7fr) minmax(0, 1.3fr);
    gap: 1rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--color-line);
  }

  .timetable-facts div:last-child {
    border-bottom: 0;
  }

  .timetable-facts dt {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .timetable-facts dd {
    margin: 0;
    color: var(--color-heading);
    font-weight: 750;
  }

  @media (max-width: 50rem) {
    .guidance-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .timetable-facts div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
