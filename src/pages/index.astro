---
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import PrayerPanel from "../components/PrayerPanel.astro";
import { donationLinks, programmes, services, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import exterior from "../assets/images/centre-exterior.jpeg";
import prayerHall from "../assets/images/prayer-hall.jpeg";
---

<BaseLayout
  title={site.name}
  description="Prayer information, programmes, madrasa, visitor details and the permanent mosque project from Carlow Islamic Cultural Centre."
  image={exterior.src}
>
  <section class="home-hero">
    <div class="hero-orbit" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Carlow, Ireland</p>
        <p class="salam" lang="ar" dir="rtl">
          السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ
        </p>
        <h1>Prayer, learning and community — rooted in Carlow.</h1>
        <p class="lede">
          Welcome to Carlow Islamic Cultural Centre: a space to worship, learn,
          connect and grow together.
        </p>
        <div class="button-row">
          <a class="button button--gold" href="/prayer-times.html">
            <Icon name="clock" size={18} />
            Prayer information
          </a>
          <a
            class="button button--ghost-light"
            href={site.directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="map" size={18} />
            Get directions
          </a>
        </div>
        <ul class="hero-facts" aria-label="Centre facts">
          <li><strong>2014</strong> Established</li>
          <li><strong>14A</strong> Carlow Shopping Centre</li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="hero-arch">
          <Image
            src={exterior}
            alt="The entrance and exterior of Carlow Islamic Cultural Centre"
            width={1024}
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero-location">
          <Icon name="map" size={20} />
          <span>
            <small>Find us in central Carlow</small>
            <strong>R93 A0E0</strong>
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="container prayer-bridge">
    <PrayerPanel compact />
  </div>

  <section class="section quick-section" aria-labelledby="quick-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 id="quick-title">What do you need today?</h2>
        </div>
        <p>
          The most-used information is one tap away, with clear contact
          fallbacks whenever details need confirmation.
        </p>
      </div>

      <div class="quick-grid">
        <a class="quick-card quick-card--primary" href="/prayer-times.html">
          <span class="icon-disc"><Icon name="clock" size={24} /></span>
          <span>
            <strong>Prayer & Jumu'ah</strong>
            <small>Check the current timetable status</small>
          </span>
          <Icon name="arrow" size={20} />
        </a>
        <a
          class="quick-card"
          href={site.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon-disc"><Icon name="map" size={24} /></span>
          <span>
            <strong>Visit the centre</strong>
            <small>Address and directions</small>
          </span>
          <Icon name="arrow" size={20} />
        </a>
        <a class="quick-card" href="/activities.html">
          <span class="icon-disc"><Icon name="calendar" size={24} /></span>
          <span>
            <strong>Classes & programmes</strong>
            <small>See the published weekly schedule</small>
          </span>
          <Icon name="arrow" size={20} />
        </a>
        <a class="quick-card" href="/madrasa.html">
          <span class="icon-disc"><Icon name="book" size={24} /></span>
          <span>
            <strong>Children's madrasa</strong>
            <small>Sessions, curriculum and enquiries</small>
          </span>
          <Icon name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="programmes-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What's on</p>
          <h2 id="programmes-title">A weekly rhythm of learning.</h2>
        </div>
        <div>
          <p>
            These recurring programmes reflect the centre's published
            schedule. Confirm before travelling, especially around seasonal
            prayer changes.
          </p>
          <a class="text-link" href="/activities.html">
            View all programmes <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="programme-grid">
        {
          programmes.slice(0, 3).map((programme) => (
            <article class="programme-card">
              <span class="tag">{programme.audience}</span>
              <h3>{programme.name}</h3>
              <p>
                <Icon name="clock" size={17} />
                {programme.schedule}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="welcome-title">
    <div class="container two-column">
      <div class="media-frame media-frame--arch">
        <Image
          src={prayerHall}
          alt="Community members gathered inside Carlow Masjid"
          width={960}
          quality={82}
          loading="lazy"
        />
      </div>
      <div class="content-stack">
        <p class="eyebrow">More than a prayer space</p>
        <h2 id="welcome-title">Faith, knowledge and neighbourliness.</h2>
        <p class="lede">
          CICC supports worship, Islamic education and community connection for
          Muslims in Carlow and the surrounding area.
        </p>
        <div class="service-list">
          {
            services.map((service) => (
              <div class="service-row">
                <span class="icon-disc">
                  <Icon name={service.icon} size={22} />
                </span>
                <span>
                  <strong>{service.title}</strong>
                  <small>{service.description}</small>
                </span>
              </div>
            ))
          }
        </div>
        <div>
          <a class="button button--outline" href="/about.html">
            Our story <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section project-section" aria-labelledby="project-title">
    <div class="container project-panel">
      <div>
        <p class="eyebrow eyebrow--light">A permanent home</p>
        <h2 id="project-title">Help build Carlow's mosque and Islamic school.</h2>
        <p>
          The community is raising funds for a larger, permanent space for
          worship, education and community life.
        </p>
      </div>
      <div class="project-actions">
        <a
          class="button button--gold"
          href={donationLinks.goFundMe}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="heart" size={18} />
          Donate on GoFundMe
        </a>
        <a class="button button--ghost-light" href="/projects.html">
          Explore the project
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(8rem, 14vw, 12rem);
    color: rgba(255, 255, 255, 0.76);
    background:
      radial-gradient(circle at 75% 20%, rgba(34, 142, 114, 0.25), transparent 35%),
      linear-gradient(135deg, #0a3028, var(--color-ink) 60%);
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image:
      linear-gradient(30deg, transparent 48%, white 49% 51%, transparent 52%),
      linear-gradient(150deg, transparent 48%, white 49% 51%, transparent 52%);
    background-size: 3.5rem 6rem;
    mask-image: linear-gradient(to left, black, transparent 70%);
  }

  .hero-orbit {
    position: absolute;
    top: -18rem;
    right: -13rem;
    width: 42rem;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    box-shadow:
      0 0 0 5rem rgba(255, 255, 255, 0.025),
      0 0 0 10rem rgba(255, 255, 255, 0.015);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.07fr) minmax(22rem, 0.93fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .hero-copy {
    max-width: 46rem;
  }

  .home-hero .eyebrow {
    color: var(--color-gold-soft);
  }

  .salam {
    width: fit-content;
    margin: 1.4rem 0 0.6rem;
    color: var(--color-mint);
    font-family: "Noto Naskh Arabic", "Geeza Pro", serif;
    font-size: clamp(1rem, 2vw, 1.35rem);
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    color: white;
  }

  .home-hero .lede {
    max-width: 39rem;
    margin: 1.4rem 0 1.8rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.25rem;
    padding: 0;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.78rem;
    list-style: none;
  }

  .hero-facts li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .hero-facts strong {
    color: white;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .hero-visual {
    position: relative;
    max-width: 31rem;
    margin-left: auto;
  }

  .hero-arch {
    overflow: hidden;
    aspect-ratio: 0.82;
    background: var(--color-mist);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50% 50% 1.5rem 1.5rem / 30% 30% 1.5rem 1.5rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.3);
  }

  .hero-arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-location {
    position: absolute;
    right: -1.5rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 1rem;
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(10px);
  }

  .hero-location :global(.icon) {
    color: var(--color-emerald);
  }

  .hero-location span {
    display: grid;
  }

  .hero-location small {
    color: var(--color-text-muted);
    font-size: 0.66rem;
  }

  .prayer-bridge {
    position: relative;
    z-index: 3;
    margin-top: clamp(-6.5rem, -8vw, -4.25rem);
  }

  .quick-section {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .quick-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 8rem;
    padding: 1.25rem;
    color: var(--color-ink);
    background: white;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .quick-card:hover {
    color: var(--color-ink);
    border-color: var(--color-emerald);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .quick-card .icon-disc {
    margin: 0;
  }

  .quick-card > span:nth-child(2) {
    display: grid;
  }

  .quick-card strong {
    font-size: 1.03rem;
  }

  .quick-card small {
    color: var(--color-text-muted);
  }

  .quick-card--primary {
    color: white;
    background: var(--color-emerald-dark);
    border-color: var(--color-emerald-dark);
  }

  .quick-card--primary:hover {
    color: white;
  }

  .quick-card--primary .icon-disc {
    color: var(--color-gold-soft);
    background: rgba(255, 255, 255, 0.09);
  }

  .quick-card--primary small {
    color: rgba(255, 255, 255, 0.68);
  }

  .programme-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .programme-card {
    min-height: 16rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: white;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .programme-card h3 {
    margin: 2.5rem 0 1.5rem;
  }

  .programme-card p {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .programme-card p :global(.icon) {
    flex: 0 0 auto;
    margin-top: 0.23rem;
    color: var(--color-emerald);
  }

  .text-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 800;
  }

  .service-list {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .service-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .service-row .icon-disc {
    width: 2.75rem;
    margin: 0;
  }

  .service-row > span:last-child {
    display: grid;
  }

  .service-row small {
    color: var(--color-text-muted);
  }

  .project-section {
    color: rgba(255, 255, 255, 0.72);
    background: var(--color-ink);
  }

  .project-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto;
    align-items: end;
    gap: 3rem;
  }

  .project-panel h2 {
    max-width: 15ch;
    margin: 0.6rem 0 1rem;
    color: white;
  }

  .project-panel p:not(.eyebrow) {
    max-width: 42rem;
  }

  .project-actions {
    display: grid;
    gap: 0.75rem;
    min-width: 15rem;
  }

  @media (max-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      width: min(100%, 31rem);
      margin: 0;
    }

    .home-hero {
      padding-bottom: 9rem;
    }

    .programme-grid {
      grid-template-columns: 1fr 1fr;
    }

    .project-panel {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      padding-top: 3.5rem;
    }

    .hero-visual {
      display: none;
    }

    .hero-facts {
      gap: 0.75rem 1rem;
    }

    .quick-grid,
    .programme-grid {
      grid-template-columns: 1fr;
    }

    .quick-card {
      min-height: 6.5rem;
    }

    .project-actions {
      width: 100%;
    }
  }
</style>
