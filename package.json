{
  "name": "cicc-carlow-masjid",
  "version": "1.0.0",
  "description": "The official website of Carlow Islamic Cultural Centre.",
  "repository": "git@github.com:carlowmasjidcicc/carlowmasjidcicc.github.io.git",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:prayer-pdfs": "node scripts/generate-prayer-pdfs.mjs",
    "dev": "npm run generate:prayer-pdfs && astro dev",
    "start": "npm run generate:prayer-pdfs && astro dev",
    "build": "npm run generate:prayer-pdfs && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run validate:html && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "astro": "7.4.4",
    "html-validate": "11.17.0",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
